---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Search & Results | Science Orbit">
    <div class="max-w-screen-2xl mx-auto px-6 py-12 md:px-8">
        <!-- Search Hero Section -->
        <section class="mb-16 flex flex-col items-center text-center">
            <h1 class="font-headline text-5xl md:text-[3.5rem] text-primary mb-8 tracking-tight max-w-4xl leading-tight">
                Discover the <span class="text-secondary italic">Global Lab</span>
            </h1>
            
            <!-- Physics-Defying Search Bar -->
            <div class="w-full max-w-4xl relative group">
                <div class="absolute -inset-1 bg-gradient-to-r from-secondary to-primary-container rounded-[1rem] blur opacity-10 group-focus-within:opacity-30 transition-opacity"></div>
                <div class="relative bg-surface-container-lowest rounded-[1rem] shadow-[0_20px_40px_rgba(0,51,69,0.06)] flex flex-col md:flex-row items-center p-2">
                    <span class="hidden md:inline-flex material-symbols-outlined ml-4 text-secondary scale-125">search</span>
                    <input class="w-full px-4 py-4 text-lg md:text-xl font-headline border-none focus:ring-0 placeholder-outline-variant bg-transparent" placeholder="Search researchers, campuses, or legacy alumni..." type="text" value="Quantum Computing Students 2024">
                    <button class="w-full md:w-auto bg-gradient-to-br from-primary to-primary-container text-white px-8 py-4 rounded-md font-headline font-medium transition-transform active:scale-95 shadow-md">
                        Find Orbit
                    </button>
                </div>
                
                <!-- Suggestions Chips -->
                <div class="flex flex-wrap gap-2 mt-4 justify-center">
                    <span class="bg-surface-container-high px-4 py-1.5 rounded-full text-xs font-medium text-on-surface-variant cursor-pointer hover:bg-secondary-container hover:text-on-secondary-container transition-colors shadow-sm">Recent: Mars Base Alpha</span>
                    <span class="bg-surface-container-high px-4 py-1.5 rounded-full text-xs font-medium text-on-surface-variant cursor-pointer hover:bg-secondary-container hover:text-on-secondary-container transition-colors shadow-sm">Trending: Plasma Physics</span>
                    <span class="bg-surface-container-high px-4 py-1.5 rounded-full text-xs font-medium text-on-surface-variant cursor-pointer hover:bg-secondary-container hover:text-on-secondary-container transition-colors shadow-sm">Alumni: Dr. Elena Vance</span>
                </div>
            </div>
        </section>

        <!-- Filters & Tabs Grid -->
        <div class="flex flex-col lg:flex-row gap-12">
            <!-- Sidebar Filters -->
            <aside class="w-full lg:w-64 space-y-8 order-2 lg:order-1">
                <div class="bg-surface-container-low p-6 rounded-2xl border border-surface-container-highest">
                    <h3 class="font-headline text-lg font-bold text-primary mb-4">Timeframe</h3>
                    <div class="space-y-3">
                        <label class="flex items-center gap-3 cursor-pointer group">
                            <div class="w-5 h-5 rounded border border-outline group-hover:border-secondary transition-colors flex items-center justify-center">
                                <div class="w-2.5 h-2.5 bg-secondary rounded-sm opacity-0 group-hover:opacity-20"></div>
                            </div>
                            <span class="text-sm font-medium text-on-surface-variant">Class of 2024</span>
                        </label>
                        <label class="flex items-center gap-3 cursor-pointer group">
                            <div class="w-5 h-5 rounded border-2 border-secondary bg-secondary flex items-center justify-center">
                                <span class="material-symbols-outlined text-[14px] text-white font-bold">check</span>
                            </div>
                            <span class="text-sm font-bold text-on-surface">Class of 2023</span>
                        </label>
                        <label class="flex items-center gap-3 cursor-pointer group">
                            <div class="w-5 h-5 rounded border border-outline group-hover:border-secondary transition-colors"></div>
                            <span class="text-sm font-medium text-on-surface-variant">Class of 2022</span>
                        </label>
                    </div>
                </div>

                <div>
                    <h3 class="font-headline text-lg font-bold text-primary mb-4 px-2">Location</h3>
                    <div class="relative overflow-hidden rounded-2xl h-40 bg-surface-container shadow-inner ring-1 ring-black/5 group">
                        <img alt="Geneva Campus" class="w-full h-full object-cover opacity-80 group-hover:scale-110 transition-transform duration-700" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAF2oLrRha86s1s5W-EIn3b9iAtx4ke8Wtz0unrYGYIPMpKTPulhX2I4nw-IzXxeLHARR8Q5FJrc81jD1w6W3xAIZSJbEBiN_3mDJUn21r04HHyvQ7ufVYV8pnEUzsW3Eni_K9DgXuveb5O6A0bQueU3HRxiiWFsBKtgjycQ7tuM4bFkOXcPo-NnTPHaEkgxA_Wmh9G0HdDsQglesdnmtGLk4sdY6rhevEXpGJeCT-73zSWfZROx5YbrlS5QwZf90n63EGh9NdvEuA">
                        <div class="absolute inset-0 bg-gradient-to-t from-primary/60 to-transparent flex items-end p-4">
                            <span class="text-white text-xs font-bold uppercase tracking-widest drop-shadow-sm">Geneva Campus</span>
                        </div>
                    </div>
                </div>

                <div class="px-2">
                    <h3 class="font-headline text-lg font-bold text-primary mb-4">Laboratory Role</h3>
                    <div class="flex flex-wrap gap-2">
                        <span class="bg-secondary text-white px-3 py-1.5 rounded-full text-[10px] font-bold uppercase tracking-widest shadow-sm">Current Student</span>
                        <span class="bg-surface-container-highest text-on-surface-variant px-3 py-1.5 rounded-full text-[10px] font-bold uppercase tracking-widest hover:bg-secondary-container hover:text-secondary-container-on transition-colors cursor-pointer border border-outline-variant/50">Passed Out</span>
                        <span class="bg-surface-container-highest text-on-surface-variant px-3 py-1.5 rounded-full text-[10px] font-bold uppercase tracking-widest hover:bg-secondary-container hover:text-secondary-container-on transition-colors cursor-pointer border border-outline-variant/50">Admin</span>
                        <span class="bg-surface-container-highest text-on-surface-variant px-3 py-1.5 rounded-full text-[10px] font-bold uppercase tracking-widest hover:bg-secondary-container hover:text-secondary-container-on transition-colors cursor-pointer border border-outline-variant/50">Faculty</span>
                    </div>
                </div>
            </aside>

            <!-- Results Section -->
            <div class="flex-1 order-1 lg:order-2">
                <!-- Navigation Tabs -->
                <div class="flex gap-4 md:gap-8 mb-8 border-b border-surface-container-high overflow-x-auto no-scrollbar">
                    <button class="whitespace-nowrap pb-4 text-lg font-headline font-bold text-secondary border-b-2 border-secondary relative flex items-center">
                        Students <span class="ml-2 text-[10px] bg-secondary-container text-on-secondary-container px-2 py-0.5 rounded-full font-bold">124</span>
                    </button>
                    <button class="whitespace-nowrap pb-4 text-lg font-headline font-bold text-on-surface-variant hover:text-primary transition-colors flex items-center">
                        Alumni <span class="ml-2 text-[10px] bg-surface-container-highest text-on-surface-variant px-2 py-0.5 rounded-full font-bold">892</span>
                    </button>
                    <button class="whitespace-nowrap pb-4 text-lg font-headline font-bold text-on-surface-variant hover:text-primary transition-colors flex items-center">
                        Campuses <span class="ml-2 text-[10px] bg-surface-container-highest text-on-surface-variant px-2 py-0.5 rounded-full font-bold">12</span>
                    </button>
                </div>

                <!-- Bento Grid Results -->
                <div class="bento-grid">
                    <!-- Result Card 1 -->
                    <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-[0_20px_40px_rgba(0,51,69,0.06)] group hover:-translate-y-1 transition-all duration-300 relative overflow-hidden border border-slate-100">
                        <div class="absolute top-0 left-0 w-1.5 h-full bg-tertiary"></div>
                        <div class="flex items-start justify-between mb-6">
                            <div class="w-16 h-16 rounded-full overflow-hidden ring-4 ring-secondary/10 bg-slate-100">
                                <img alt="Marcus Thorne" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuATD3YhyY7NIrDFM5oHCXOovaLyhICb4x5f6UQSOg1mY2s3wWqUhqaNMCSmfykG5C916Ev1T9UWEWCUhYTGiMHI3bs9TTOL7dYzhgBElTHDe1ZcV2P6FfWLqaHjp3xhPyT30awB-8r4eDE2rZ9KhCSVw8A_tMpHYVfH_rsr6w0JHjn7JX933s4Io8hyEv4dqJ1dJp-hrDSbrn46Lp_20uGVq541QHbl2MveBm6ZXI9m0zU_AcR8sQev4IeqENUQZ-4NJNwmsl0v4Jg">
                            </div>
                            <span class="bg-secondary/10 text-secondary px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest">Active</span>
                        </div>
                        <h4 class="font-headline text-2xl font-bold text-primary mb-1">Marcus Thorne</h4>
                        <p class="text-on-surface-variant text-sm font-medium mb-6">Neuro-Robotics Specialist • Year 3</p>
                        <div class="flex flex-col gap-3 border-t border-surface-container pt-5">
                            <div class="flex justify-between items-center text-xs">
                                <span class="text-outline uppercase tracking-wider font-bold">UID</span>
                                <span class="font-mono font-medium text-primary bg-primary/5 px-2 py-0.5 rounded">ORB-2024-9912</span>
                            </div>
                            <div class="flex justify-between items-center text-xs">
                                <span class="text-outline uppercase tracking-wider font-bold">Campus</span>
                                <span class="text-primary font-medium flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">location_on</span> Lunar North</span>
                            </div>
                        </div>
                    </div>

                    <!-- Result Card 2 -->
                    <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-[0_20px_40px_rgba(0,51,69,0.06)] group hover:-translate-y-1 transition-all duration-300 relative overflow-hidden border border-slate-100">
                        <div class="absolute top-0 left-0 w-1.5 h-full bg-secondary"></div>
                        <div class="flex items-start justify-between mb-6">
                            <div class="w-16 h-16 rounded-full overflow-hidden ring-4 ring-secondary/10 bg-slate-100">
                                <img alt="Dr. Sarah Chen" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCQXbmd3GmGY2z4T8UytivNhefJVk4uQipWVEQLzaBO0wMLG_qxYMoDcNzqCvVELKeU1Qc-ON5RxK_0x0Ol3sWlCn_p_0hYLt1F8wNP_b3Ada1ovNHztzRKTNPe4qKaBpOy1yJ7XE_byd5AIFxLGiAbDBX4Luyqe-AAWqRRTULWFNpGfbPBbMYd8CrdHTQvOyRRLvEcMvOjdXPHdFxsJG50Sejf-Szvgs7NOkrL-jytxzg5GCbdpKNJf3leseRlQoEsQPYodFrss5s">
                            </div>
                            <span class="bg-tertiary/10 text-tertiary px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest">Alumni</span>
                        </div>
                        <h4 class="font-headline text-2xl font-bold text-primary mb-1">Dr. Sarah Chen</h4>
                        <p class="text-on-surface-variant text-sm font-medium mb-6">Astro-Geologist • Alumni '19</p>
                        <div class="flex flex-col gap-3 border-t border-surface-container pt-5">
                            <div class="flex justify-between items-center text-xs">
                                <span class="text-outline uppercase tracking-wider font-bold">Current Role</span>
                                <span class="text-primary font-medium truncate max-w-[150px]" title="Lead Researcher Space Expl">Lead Researcher...</span>
                            </div>
                            <div class="flex justify-between items-center text-xs">
                                <span class="text-outline uppercase tracking-wider font-bold">Campus</span>
                                <span class="text-primary font-medium flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">location_on</span> Beijing Orbital</span>
                            </div>
                        </div>
                    </div>

                    <!-- Campus Result Card -->
                    <div class="bg-surface-container-lowest rounded-2xl shadow-[0_20px_40px_rgba(0,51,69,0.06)] group hover:-translate-y-1 transition-all duration-300 overflow-hidden col-span-1 lg:col-span-2 flex flex-col md:flex-row border border-slate-100 mt-4 md:mt-0">
                        <div class="w-full md:w-1/2 h-48 md:h-auto relative bg-slate-100">
                            <img alt="Zurich Campus" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCwsyJ5Pn76sF6iTUDDGKyJQMIS2MbYtflVSqa2WQoEi7lXf00Q4suTznmobvUi8EbjMtw0oNckuWsnKCjyU2pRju8-f0zQmeTmsO2X_wRFpN4FLvtfKIMuWrtHNtA_lr06bWU-Wq77p6mu4oyHKOj-qImRtTzaaeC0iLuGUTjROiRkxQxauM6XRIP570_rPKVQTAZhdPUdSAb2Lp-CaSlCR8Hh3QxVMzf3-LQKA1Eyk0GAn7YPVMRZUCWv1BvZgwfhLgMRUsAQf14">
                            <div class="absolute inset-0 bg-gradient-to-r from-white via-white/80 to-transparent hidden md:block"></div>
                        </div>
                        <div class="p-8 flex flex-col justify-center flex-1 relative z-10 bg-white/90 md:bg-transparent backdrop-blur-md md:backdrop-blur-none">
                            <div class="flex items-center gap-2 mb-3">
                                <span class="material-symbols-outlined text-secondary text-xl">domain</span>
                                <span class="text-[10px] font-bold text-secondary uppercase tracking-widest bg-secondary/10 px-2 py-0.5 rounded">Main Campus</span>
                            </div>
                            <h4 class="font-headline text-3xl font-bold text-primary mb-3">Zurich Central Laboratory</h4>
                            <p class="text-on-surface-variant text-sm mb-8 leading-relaxed max-w-sm">The flagship hub for subatomic research and quantum entanglement studies. Home to 4,500 active orbits.</p>
                            <div class="flex gap-4">
                                <button class="text-white bg-secondary px-6 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider hover:bg-secondary/90 transition-colors shadow-md">View Directory</button>
                                <button class="text-on-surface-variant border border-outline-variant/40 px-6 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider hover:bg-surface-container transition-colors shadow-sm bg-white">Virtual Tour</button>
                            </div>
                        </div>
                    </div>

                    <!-- Result Card 3 -->
                    <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-[0_20px_40px_rgba(0,51,69,0.06)] group hover:-translate-y-1 transition-all duration-300 relative overflow-hidden border border-slate-100">
                        <div class="absolute top-0 left-0 w-1.5 h-full bg-outline-variant"></div>
                        <div class="flex items-start justify-between mb-6">
                            <div class="w-16 h-16 rounded-full overflow-hidden ring-4 ring-secondary/10 bg-slate-100">
                                <img alt="Prof. Julian Vane" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAtq3CzXBCGUHKOSyLauXvu4qlTAlZBu0BZ1OHmd9_sErOXLG8nrJ8ciu_avey_sieUwc7eTGgu--w2cnK6bPzEXLJcULRbQjsGLYJAWbgalytSwzCkz_enAMopm0sGNwZaTtTkKzFflxmfCBgHWq29kIKy5kyqzJ05SQLDNvUCAPE7M4vb6nk5SAQQLr834ZXrLa0WFpKg7YVAa8DdWBMGoDOOMYNaztXLUHQeFfhbNSj5m-sPMztba9lO43CRteZK58Ztulvgbik">
                            </div>
                            <span class="bg-primary/10 text-primary px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest">Admin</span>
                        </div>
                        <h4 class="font-headline text-2xl font-bold text-primary mb-1">Prof. Julian Vane</h4>
                        <p class="text-on-surface-variant text-sm font-medium mb-6">Dean of Sciences • Faculty</p>
                        <div class="flex flex-col gap-3 border-t border-surface-container pt-5">
                            <div class="flex justify-between items-center text-xs">
                                <span class="text-outline uppercase tracking-wider font-bold">Office</span>
                                <span class="font-medium text-primary">Hall 7, Chamber A</span>
                            </div>
                            <div class="flex justify-between items-center text-xs">
                                <span class="text-outline uppercase tracking-wider font-bold">Extension</span>
                                <span class="font-medium text-primary">#0091</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Load More / Pagination -->
                <div class="mt-16 flex justify-center">
                    <button class="group flex items-center gap-3 text-secondary font-headline text-sm font-bold uppercase tracking-widest transition-all hover:bg-secondary/5 px-6 py-3 rounded-full">
                        <span>Expand Research Field</span>
                        <span class="material-symbols-outlined group-hover:translate-y-1 transition-transform">keyboard_arrow_down</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
    .bento-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
    }
    .no-scrollbar::-webkit-scrollbar { display: none; }
</style>
