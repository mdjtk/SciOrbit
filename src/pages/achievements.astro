                        </div>
                    </div>
                    <h5 class="font-headline font-bold text-primary text-sm mb-1">Arjun Das</h5>
                    <p class="text-xs text-slate-500">JEE Percentile: 99.2</p>
                </div>
                <!-- Registry Card 4 -->
                <div class="weightless-card group cursor-pointer">
                    <div class="aspect-[4/5] rounded-2xl overflow-hidden mb-4 grayscale group-hover:grayscale-0 transition-all duration-500 relative bg-slate-100 border border-slate-100">
                        <img alt="Ananya Nair" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDbseGsLtzQjOULbtn-OSx0mdApvrdthWhnBudEbDdPC0lOSXEH2OB12oGNyIORUSrhszLsbFH0gFdI6GO26T0Ot84coqTlAhoGmJOJG7oCcD62fro6qNvam0owOTaAM3KW7JlzJoGbMhoFN8dZSWAAYIOj3-2frqxMpkKaBz-NKwYbSg31kGmDzA2GelGOjCCE_gdcvHJYnmfKN2iOINjMT1c4q1-6FudE73ERM9k7gFYW4HRbAi8Qpzbq-njvE2rcvptNcTP_v6E"/>
