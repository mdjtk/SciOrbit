                    <div class="aspect-[4/5] rounded-2xl overflow-hidden mb-4 grayscale group-hover:grayscale-0 transition-all duration-500 relative bg-slate-100 border border-slate-100">
                        <img alt="Arjun Das" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDxNQ1_fcsDixVqwRGhq5PFG-GPPSLxlWWiMZqNh6HpKIiYBdLsP0aIDPEKo8NLLbldS7O30ZDQIyZtGQ6X0bMcNnQvAxIsDguwMYfuB4DN64KWdKaFIZtfNHSCAE8aCi-IQzh84aq84x243LBP6lqhl5HcEJuAEzqAwVk1envK6MkI0UIljUA_iu62Nul_LgsuzdCjOWX4ts8aCMa5b_MF9-5fKUX1PKeHqOsGTKZ9Urz0t3NNcRE8CrELdPPIPyx6eV0Tgog3xCw"/>
